# Voice engine: voicestudio (default) | elevenlabs | say. There is no fallback: when
# VoiceStudio can't be reached or started, the voice step stops and says why.
VOICE_PROVIDER=voicestudio

# VoiceStudio: free and local, https://github.com/debpalash/VoiceStudio
VOICESTUDIO_URL=http://127.0.0.1:3900
# Headless install the kit starts automatically when nothing answers at VOICESTUDIO_URL.
# Empty = ./voicestudio (where `npm run setup` puts it), else ~/VoiceStudio if that exists.
VOICESTUDIO_DIR=
# Engine id. Default "mlx-audio" = Kokoro (Apache-2.0, nothing to accept, English + a few
# languages, no German). "omnivoice" adds cloning and German but is non-commercial and
# needs its licence accepted in VoiceStudio first.
VOICESTUDIO_MODEL=mlx-audio
# Kokoro preset (af_heart is its only grade-A English voice), or a saved voice profile
# name/id when using a cloning engine.
VOICESTUDIO_VOICE=af_heart
# Optional: speaking speed (1.0 = normal; *heavy* words go 0.85× of it), language hint for
# caption timing ("en", "de"), and a key only if the backend runs on another machine.
VOICESTUDIO_SPEED=
VOICESTUDIO_LANGUAGE=
VOICESTUDIO_API_KEY=

# ElevenLabs (paid, cloud). Copy a voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# macOS voice, only used with VOICE_PROVIDER=say (`say -v '?'` lists them). Empty = system default.
SAY_VOICE=Samantha
SAY_RATE=195
